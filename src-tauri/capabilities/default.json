{
  "identifier": "default",
  "description": "主窗口与截图取景框所需的最小权限",
  "windows": ["main", "capture"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-inner-size",
    "allow-open-capture",
    "allow-capture-frame"
  ]
}