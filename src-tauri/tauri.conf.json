{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "鏅烘亱bot",
  "version": "1.0.5",
  "identifier": "com.zhilianbot.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "鏅烘亱bot",
        "width": 1200,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese"
        ]
      }
    }
  }
}
